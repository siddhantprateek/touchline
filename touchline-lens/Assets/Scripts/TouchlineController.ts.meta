  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">TouchlineController – LIVE / REPLAY state machine</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input SceneObject tableRoot {"hint":"Root of the virtual coffee table (its meshes dim during replays)"}'
    - '// @input AssignableType_1 pitch {"hint":"Pitch builder (turf/lines/goals)"}'
    - '// @input AssignableType_2 formation {"hint":"22 player tokens"}'
    - '// @input AssignableType_3 timeline {"hint":"Goal/shot timeline markers"}'
