    - '// @input AssignableType_5 shotArc {"hint":"Goal pop-out arc"}'
    - '// @input AssignableType_6 celebration {"hint":"Confetti + GOAL banner when a goal arc lands (optional)"}'
    - '// @input AssignableType_7 audio {"hint":"Crowd roar / net audio"}'
    - '// @input AssignableType_8 scoreboard {"hint":"Score + LIVE clock label"}'
    - '// @input AssignableType_9 skip {"hint":"Skip to next moment button"}'
    - '// @input AssignableType_10 scrubber {"hint":"Replay scrub slider"}'
    - '// @input AssignableType_11 card {"hint":"Player card"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input float startClockSec = 1290 {"hint":"Simulated clock start, match seconds (1290 = 21:30, 54 s before the first goal)", "widget":"slider", "min":0, "max":7400, "step":1}'
    - '// @input float clockSpeed = 10 {"hint":"Simulated clock speed (match seconds per real second)", "widget":"slider", "min":1, "max":60, "step":1}'
    - '// @input float skipLeadSec = 3 {"hint":"Skip lands this many match seconds before the next marker", "widget":"slider", "min":0, "max":15, "step":0.5}'
    - '// @input float replayDim = 0.6 {"hint":"Table + pitch brightness during a replay (1 = no dimming)", "widget":"slider", "min":0.2, "max":1, "step":0.05}'
    - '// @input float goalHoldSec = 1.4 {"hint":"Seconds to hold on the net after a goal arc lands before returning to LIVE", "widget":"slider", "min":0, "max":5, "step":0.1}'
    - '// @input float shotHoldSec = 0.8 {"hint":"Seconds to hold on the last frame of a non-goal replay", "widget":"slider", "min":0, "max":5, "step":0.1}'
    - '// @ui {"widget":"group_end"}'
