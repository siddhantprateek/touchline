  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">TouchlineFormationView – 22 pinchable player tokens</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input Asset.Material unlitMaterial {"hint":"Unlit base material (cloned per token part)"}'
    - '// @input Asset.RenderMesh cylinderMesh {"hint":"Cylinder mesh for the token discs"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input float tokenDiameterCm = 1.7 {"hint":"Token visual diameter in cm", "widget":"slider", "min":0.8, "max":3, "step":0.05}'
    - '// @input float numberSize = 36 {"hint":"Shirt-number text size (Lens Studio text points; ~36 gives digits about 0.8 cm tall)", "widget":"slider", "min":12, "max":80, "step":1}'
    - '// @input float pinchDiameterCm = 4 {"hint":"Invisible pinch-area diameter in cm (larger than the token so tiny players are easy to pinch)", "widget":"slider", "min":1.5, "max":6, "step":0.1}'
    - '// @input float hoverScale = 1.35 {"hint":"Scale applied to a token while it is aimed at", "widget":"slider", "min":1, "max":2, "step":0.05}'
    - '// @input float idleDriftCm = 0.35 {"hint":"Idle drift amplitude in LIVE mode, cm", "widget":"slider", "min":0, "max":1.5, "step":0.05}'
    - '// @input float followSpeed = 8 {"hint":"How quickly tokens glide to new positions (higher = snappier)", "widget":"slider", "min":1, "max":30, "step":0.5}'
    - '// @input vec4 homeColor = "{0.3,0.65,1,1}" {"hint":"Argentina shirt colour (celeste); deep enough that the white number stays readable", "widget":"color"}'
    - '// @input vec4 homeAccent = "{1,1,1,1}" {"hint":"Argentina shirt stripes (white)", "widget":"color"}'
    - '// @input vec4 homeShorts = "{0.12,0.16,0.45,1}" {"hint":"Argentina shorts: the base ring (navy; real black would vanish on the additive display)", "widget":"color"}'
    - '// @input vec4 homeKeeper = "{0.75,1,0.15,1}" {"hint":"Argentina goalkeeper shirt", "widget":"color"}'
    - '// @input vec4 awayKeeper = "{1,0.5,0.1,1}" {"hint":"France goalkeeper shirt", "widget":"color"}'
    - '// @input vec4 awayStripe = "{1,0.15,0.2,1}" {"hint":"France shirt stripe (red)", "widget":"color"}'
    - '// @input vec4 numberColor = "{1,1,1,1}" {"hint":"Shirt-number colour (white; avoid black, it disappears on the additive display)", "widget":"color"}'
    - '// @input vec4 awayColor = "{0.18,0.36,1,1}" {"hint":"France token body (bright royal blue)", "widget":"color"}'
    - '// @input vec4 awayOutline = "{1,1,1,1}" {"hint":"France shorts: the base ring (white)", "widget":"color"}'
    - '// @input vec4 namedRingColor = "{1,0.85,0.35,1}" {"hint":"Ring under named (pinchable) players during a replay", "widget":"color"}'
    - '// @ui {"widget":"group_end"}'
