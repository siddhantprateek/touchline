    - '// @input float markerHeightCm = 1.6 {"hint":"Marker height above the table, cm", "widget":"slider", "min":0.5, "max":5, "step":0.1}'
    - '// @input float pulseSec = 2 {"hint":"Pulse duration when the clock reaches a marker, seconds", "widget":"slider", "min":0.3, "max":4, "step":0.1}'
    - '// @input vec4 goalColor = "{1,0.86,0.3,1}" {"hint":"Goal marker colour", "widget":"color"}'
    - '// @input vec4 shotColor = "{0.85,0.9,1,1}" {"hint":"Shot marker colour", "widget":"color"}'
    - '// @input vec4 stripColor = "{0.7,0.75,0.8,1}" {"hint":"Timeline strip colour", "widget":"color"}'
    - '// @input float futureBrightness = 0.45 {"hint":"Brightness of markers the clock has not reached yet (0..1)", "widget":"slider", "min":0.1, "max":1, "step":0.05}'
