    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input float goalMarkerCm = 2.6 {"hint":"Goal marker diameter, cm", "widget":"slider", "min":1, "max":5, "step":0.1}'
